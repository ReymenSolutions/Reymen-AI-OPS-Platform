generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANT ──────────────────────────────────────────────────────

model Organization {
  id                       String   @id @default(cuid())
  name                     String
  slug                     String   @unique
  industry                 String?
  logoUrl                  String?
  isActive                 Boolean  @default(true)
  plan                     String   @default("starter")
  stripeCustomerId         String?  @unique
  stripeSubscriptionId     String?  @unique
  stripeSubscriptionStatus String?
  n8nWebhookSecret         String   @unique
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  users                 User[]
  leads                 Lead[]
  automations           Automation[]
  conversations         Conversation[]
  appointments          Appointment[]
  requests              Request[]
  metrics               Metric[]
  auditLogs             AuditLog[]
  webhookEvents         WebhookEvent[]
  whatsappAssistant     WhatsAppAssistant?
  knowledgeBase         KnowledgeBase[]
  prompts               Prompt[]
  templateInstallations TemplateInstallation[]
  modules               OrganizationModule[]

  @@index([slug])
}

// ─── USERS & AUTH ─────────────────────────────────────────────────

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  name                 String?
  image                String?
  passwordHash         String?
  role                 UserRole @default(CLIENT)
  organizationId       String?
  isActive             Boolean  @default(true)
  theme                String?  @default("light")
  language             String?  @default("es")
  totpSecret           String? // base32 TOTP secret; set once enrollment begins
  totpEnabled          Boolean  @default(false)
  totpBackupCodeHashes String[] @default([]) // bcrypt hashes, single-use, cleared/regenerated on re-enroll
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  accounts     Account[]
  sessions     Session[]

  @@index([organizationId])
  @@index([email])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OWNER
  MANAGER
  AGENT
  VIEWER
  CLIENT
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── LEADS CRM ────────────────────────────────────────────────────

model Lead {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  source         String?
  status         LeadStatus @default(NEW)
  score          Int?
  scoreReason    String?    @db.Text
  notes          String?    @db.Text
  metadata       Json?
  assignedTo     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

// ─── AUTOMATIONS ──────────────────────────────────────────────────

model Automation {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  description    String?
  type           String
  status         AutomationStatus @default(ACTIVE)
  n8nWorkflowId  String?
  webhookSecret  String
  config         Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  events       AutomationEvent[]

  @@index([organizationId])
}

enum AutomationStatus {
  ACTIVE
  PAUSED
  ERROR
  ARCHIVED
}

model AutomationEvent {
  id             String      @id @default(cuid())
  automationId   String
  organizationId String
  type           String
  status         EventStatus @default(PENDING)
  payload        Json?
  errorMessage   String?
  duration       Int?
  createdAt      DateTime    @default(now())

  automation Automation @relation(fields: [automationId], references: [id])

  @@index([automationId])
  @@index([organizationId, createdAt])
}

enum EventStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

// ─── CONVERSATIONS ────────────────────────────────────────────────

model Conversation {
  id             String             @id @default(cuid())
  organizationId String
  channel        String
  contactPhone   String?
  contactName    String?
  status         ConversationStatus @default(OPEN)
  aiHandled      Boolean            @default(true)
  escalatedAt    DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  messages     Message[]

  @@index([organizationId])
  @@index([organizationId, status])
}

enum ConversationStatus {
  OPEN
  ESCALATED
  RESOLVED
  CLOSED
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  metadata       Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ─── APPOINTMENTS ─────────────────────────────────────────────────

model Appointment {
  id             String            @id @default(cuid())
  organizationId String
  leadId         String?
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus @default(SCHEDULED)
  source         String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, startTime])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// ─── REQUESTS ─────────────────────────────────────────────────────

model Request {
  id             String        @id @default(cuid())
  organizationId String
  title          String
  description    String        @db.Text
  type           String
  status         RequestStatus @default(OPEN)
  priority       String        @default("medium")
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ─── METRICS ──────────────────────────────────────────────────────

model Metric {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  value          Float
  period         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key, period])
  @@index([organizationId, period])
}

// ─── WEBHOOK EVENTS ───────────────────────────────────────────────

model WebhookEvent {
  id             String             @id @default(cuid())
  organizationId String
  source         String
  eventType      String
  payload        Json
  status         WebhookEventStatus @default(PENDING)
  attempts       Int                @default(0)
  processedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@index([createdAt])
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

// ─── AUDIT LOGS ───────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([userId])
}

// ─── WHATSAPP AI ASSISTANT ────────────────────────────────────────

model WhatsAppAssistant {
  id             String   @id @default(cuid())
  organizationId String   @unique
  name           String   @default("Asistente AI")
  greeting       String   @default("¡Hola! Soy el asistente virtual. ¿En qué puedo ayudarte?") @db.Text
  personality    String?  @db.Text
  capabilities   String[]
  isActive       Boolean  @default(true)
  phoneNumber    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

// ─── KNOWLEDGE BASE ───────────────────────────────────────────────

model KnowledgeBase {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  content        String   @db.Text
  category       String?
  tags           String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, category])
  @@index([organizationId, isActive])
}

// ─── PROMPT MANAGER ───────────────────────────────────────────────

model Prompt {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  content        String     @db.Text
  type           PromptType
  isActive       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, type, isActive])
}

enum PromptType {
  SYSTEM
  GREETING
  LEAD_QUALIFICATION
  APPOINTMENT_BOOKING
  FAQ
  ESCALATION
}

// ─── TEMPLATE ENGINE ──────────────────────────────────────────────

model AutomationTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String   @db.Text
  longDescription String?  @db.Text
  industry        String // clinic, real_estate, gym, legal, workshop, ecommerce
  category        String // lead_capture, appointments, follow_up, crm, retention
  tags            String[]
  iconEmoji       String   @default("⚡")
  isPublished     Boolean  @default(false)
  currentVersion  String? // latest semver e.g. "1.0.0"
  createdBy       String? // userId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions      TemplateVersion[]
  installations TemplateInstallation[]

  @@index([industry])
  @@index([isPublished])
}

model TemplateVersion {
  id              String   @id @default(cuid())
  templateId      String
  version         String // "1.0.0"
  changelog       String?  @db.Text
  n8nWorkflowJson Json // full n8n workflow export JSON
  n8nWorkflowId   String? // ID of deployed workflow in n8n instance
  defaultConfig   Json? // default variable values for this version
  isLatest        Boolean  @default(true)
  createdAt       DateTime @default(now())

  template      AutomationTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  installations TemplateInstallation[]

  @@unique([templateId, version])
  @@index([templateId])
  @@index([templateId, isLatest])
}

model TemplateInstallation {
  id             String             @id @default(cuid())
  organizationId String
  templateId     String
  versionId      String
  automationId   String? // FK to Automation created on install
  status         InstallationStatus @default(PENDING)
  config         Json? // org-specific config overrides
  installedAt    DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  template     AutomationTemplate @relation(fields: [templateId], references: [id])
  version      TemplateVersion    @relation(fields: [versionId], references: [id])

  @@unique([organizationId, templateId])
  @@index([organizationId])
  @@index([templateId])
}

enum InstallationStatus {
  PENDING
  INSTALLING
  ACTIVE
  FAILED
  UNINSTALLED
}

// ─── PLATFORM MODULES (commercial entitlements) ──────────────────────
// Distinct from RBAC (src/lib/permissions.ts, what a user may do) and from
// feature flags (gradual rollout of experimental functionality within an
// already-enabled module). A module here answers "does this organization's
// account have access to this line of business at all" — CRM, the AI/
// WhatsApp assistant, and Automations are the only modules with real
// functionality today; NFC_QR and MARKETING_ADS are reserved for future
// modules (see docs/DOCUMENTACION_TECNICA.md) and have no schema/UI of
// their own yet.

enum PlatformModule {
  CRM
  AI_WHATSAPP
  AUTOMATIONS
  NFC_QR // reserved — no schema/UI yet, integration point for a separate future repo
  MARKETING_ADS // reserved — no schema/UI yet, future module
}

enum ModuleStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum ModuleSource {
  SUBSCRIBED // tied to a paid plan (billing wiring not implemented yet)
  ADMIN_GRANTED // enabled manually by a Reymen admin (trial, courtesy, etc.)
}

model OrganizationModule {
  id             String         @id @default(cuid())
  organizationId String
  module         PlatformModule
  status         ModuleStatus   @default(ACTIVE)
  source         ModuleSource   @default(SUBSCRIBED)
  enabledAt      DateTime       @default(now())
  suspendedAt    DateTime?
  cancelledAt    DateTime?
  notes          String?        @db.Text // why it was granted/suspended — admin-only visibility
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, module])
  @@index([organizationId])
}

// ─── RATE LIMITING ──────────────────────────────────────────────────
// DB-backed sliding window so limits hold across serverless instances
// without needing Redis. One row per attempt; see src/lib/rate-limit.ts.

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String // e.g. "login:email:user@example.com", "login:ip:1.2.3.4", "webhook:automationId"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
