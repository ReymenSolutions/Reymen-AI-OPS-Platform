# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/reymen_ops"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# Required in production ONLY if the app sits behind a reverse proxy/load
# balancer (Nginx, an ALB, etc.) — Auth.js refuses the request Host header by
# default as a security measure. Only set this to "true" when that proxy is
# trusted to set an accurate Host/X-Forwarded-Host; never enable it if the
# app is directly reachable from the internet without such a proxy in front.
# AUTH_TRUST_HOST="true"

# n8n
N8N_BASE_URL="http://n8n:5678"
N8N_WEBHOOK_SECRET="generate-a-strong-secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Reymen AI Ops"

# Email (Resend) — optional; without it, emails are logged to the console instead of sent
RESEND_API_KEY=""
EMAIL_FROM="Reymen AI Ops <onboarding@resend.dev>"

# Billing (Stripe) — optional; without STRIPE_SECRET_KEY, upgrade/manage-billing UI stays hidden
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PROFESSIONAL=""
STRIPE_PRICE_ENTERPRISE=""

# Error tracking (Sentry) — optional; without SENTRY_DSN, error capturing stays disabled
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed to upload source maps at build time (better stack traces in Sentry)
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Webhook retry cron — required to call POST /api/cron/retry-webhooks (fails closed without it)
CRON_SECRET=""

# SmartCard SSO bridge (module NFC_QR) — required for the "SmartCard" nav
# item to actually work once the module is enabled for an org; without it,
# /portal/smartcard returns a 503 instead of redirecting. Both values must
# match EXACTLY what's configured in the SmartCard product's own deploy
# (reymen-smartcard repo, apps/ops/.env.production):
#   SMARTCARD_SSO_SECRET must equal that repo's SMARTCARD_SSO_SECRET
#   SMARTCARD_OPS_URL is that repo's public ops URL, e.g. https://ops.reymen.mx
SMARTCARD_SSO_SECRET=""
SMARTCARD_OPS_URL=""
